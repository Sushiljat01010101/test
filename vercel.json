{
  "buildCommand": "pnpm --filter @workspace/royal-library run build && cp -r artifacts/royal-library/dist/public ./vercel-out",
  "outputDirectory": "vercel-out",
  "installCommand": "pnpm install --frozen-lockfile=false",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
